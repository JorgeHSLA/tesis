/.ruff_cache

# Entornos virtuales de Python (no versionar: pesados y específicos de máquina)
.venv/
venv/

# Cachés y artefactos generados
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Builds de Node / frontend
node_modules/
dist/

# Estado local de Claude Code: worktrees (checkouts completos del repo,
# registrados en `git worktree list` — quitar con `git worktree remove`),
# settings.local.json (config por máquina) y skills locales.
.claude/
.coverage
