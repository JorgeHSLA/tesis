/.ruff_cache

# Entornos virtuales de Python (no versionar: pesados y específicos de máquina)
.venv/
venv/

# Cachés y artefactos generados
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Builds de Node / frontend
node_modules/
dist/

# Estado local de Claude Code: worktrees (checkouts completos del repo,
# registrados en `git worktree list` — quitar con `git worktree remove`),
# settings.local.json (config por máquina) y skills locales.
.claude/
.coverage

# ── Credenciales · NUNCA en el repositorio (api-contract §11.8.1) ────────────
# Las claves de cuenta de servicio viven fuera del árbol (p. ej. ~/.telar-secrets/)
# y se apuntan con TELAR_GCS_CREDENTIALS. Estos patrones son la red por si alguna
# vez se copia una aquí por comodidad: que git la ignore antes de que se note.
*.credentials.json
*service-account*.json
*service_account*.json
telar-*.json
gcs-*.json
.telar-secrets/
secrets/
*.pem
*.key
