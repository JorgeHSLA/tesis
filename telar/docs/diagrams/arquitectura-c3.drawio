        <mxCell id="c_gestor" value="&lt;b&gt;Gestor de Ventana y Ciclo de Vida&lt;/b&gt;&#xa;[M&#243;dulo: Electron app]&#xa;&#xa;Crea y muestra la ventana, single-instance, carga la UI desde disco, gobierna arranque/cierre." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="b_electron">
          <mxGeometry x="40" y="60" width="240" height="150" as="geometry" />
        </mxCell>
