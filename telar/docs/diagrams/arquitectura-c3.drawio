          <mxGeometry x="440" y="60" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_guardian" value="&lt;b&gt;Guardi&#225;n de Seguridad&lt;/b&gt;&#xa;[M&#243;dulo: Electron session]&#xa;&#xa;CSP, whitelist de navegaci&#243;n, bloqueo de ventanas nuevas y permisos." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="b_electron">
          <mxGeometry x="40" y="290" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_bridge" value="&lt;b&gt;Puente de API Segura&lt;/b&gt;&#xa;[M&#243;dulo: contextBridge]&#xa;&#xa;Expone una API acotada (window.telar) al Renderer; a&#237;sla el IPC crudo." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="b_electron">
          <mxGeometry x="440" y="290" width="240" height="150" as="geometry" />
