        <mxCell id="usuario" value="&lt;b&gt;Usuario&lt;/b&gt;&#xa;&lt;i&gt;Estudiante&lt;/i&gt;&#xa;&#xa;Quiere aprender qu&#233; es&#xa;paralelismo y concurrencia" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#2B5EA7;strokeColor=#1B3F73;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;spacingTop=24;" vertex="1" parent="1">
