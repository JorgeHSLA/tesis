        <mxCell id="servicios" value="&lt;b&gt;Capa de Servicio&lt;/b&gt;&#xa;&lt;i&gt;[M&#243;dulo : services]&lt;/i&gt;&#xa;&#xa;Toda la l&#243;gica: orquestaci&#243;n de jobs, cursos, quizzes, progreso, parseo de salida." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B5EA7;strokeColor=#1B3F73;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="b_fastapi">
