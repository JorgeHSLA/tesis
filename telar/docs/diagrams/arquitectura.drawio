        </mxCell>

        <mxCell id="telar" value="&lt;b&gt;Telar&lt;/b&gt;&#xa;Sistema de software" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;dashed=1;dashPattern=8 8;container=1;pointerEvents=0;collapsible=0;verticalAlign=bottom;align=left;spacingLeft=30;spacingBottom=24;fontSize=20;fontColor=#444444;" vertex="1" parent="1">
