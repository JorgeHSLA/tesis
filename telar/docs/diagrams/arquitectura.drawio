        </mxCell>

        <mxCell id="b_electron" value="&lt;b&gt;Electron&lt;/b&gt;&#xa;Contenedor &#183; Electron 43 + React/TypeScript" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#9A9A9A;dashed=1;dashPattern=8 8;container=1;pointerEvents=0;collapsible=0;verticalAlign=bottom;align=left;spacingLeft=26;spacingBottom=22;fontSize=17;fontColor=#444444;" vertex="1" parent="telar">
          <mxGeometry x="60" y="260" width="1220" height="660" as="geometry" />
        </mxCell>
        <mxCell id="gestor" value="&lt;b&gt;Gestor de Ventana y Ciclo de Vida&lt;/b&gt;&#xa;&lt;i&gt;[M&#243;dulo : Electron app]&lt;/i&gt;&#xa;&#xa;Crea y muestra la ventana, single-instance, carga la UI desde disco, gobierna arranque/cierre." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B5EA7;strokeColor=#1B3F73;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="b_electron">
          <mxGeometry x="40" y="60" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;Aplicaci&#243;n de UI&lt;/b&gt;&#xa;&lt;i&gt;[M&#243;dulo : SPA React/TypeScript]&lt;/i&gt;&#xa;&#xa;Interfaz de cursos y simulador; consume la API segura y habla con el backend." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B5EA7;strokeColor=#1B3F73;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="b_electron">
          <mxGeometry x="460" y="60" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="guardian" value="&lt;b&gt;Guardi&#225;n de Seguridad&lt;/b&gt;&#xa;&lt;i&gt;[M&#243;dulo : Electron session]&lt;/i&gt;&#xa;&#xa;CSP, whitelist de navegaci&#243;n, bloqueo de ventanas nuevas y permisos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B5EA7;strokeColor=#1B3F73;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="b_electron">
          <mxGeometry x="40" y="340" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="puente" value="&lt;b&gt;Puente de API Segura&lt;/b&gt;&#xa;&lt;i&gt;[M&#243;dulo : contextBridge]&lt;/i&gt;&#xa;&#xa;Expone una API acotada (window.telar) al Renderer; a&#237;sla el IPC crudo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B5EA7;strokeColor=#1B3F73;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="b_electron">
          <mxGeometry x="460" y="340" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ctrl_docker" value="&lt;b&gt;Controlador de Docker&lt;/b&gt;&#xa;&lt;i&gt;[M&#243;dulo : Electron IPC + child_process]&lt;/i&gt;&#xa;&#xa;Orquesta el stack (compose up/stop/ps) con una whitelist cerrada, sin shell." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B5EA7;strokeColor=#1B3F73;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="b_electron">
          <mxGeometry x="880" y="340" width="300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b_fastapi" value="&lt;b&gt;fastApi&lt;/b&gt;&#xa;Contenedor &#183; Python 3.12 + FastAPI + uvicorn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#9A9A9A;dashed=1;dashPattern=8 8;container=1;collapsible=0;verticalAlign=bottom;align=left;spacingLeft=26;spacingBottom=22;fontSize=17;fontColor=#444444;" vertex="1" parent="telar">
