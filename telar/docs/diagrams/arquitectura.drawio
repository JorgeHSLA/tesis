        <mxCell id="controladores" value="&lt;b&gt;Controladores&lt;/b&gt;&#xa;&lt;i&gt;[M&#243;dulo : APIRouter]&lt;/i&gt;&#xa;&#xa;Endpoints REST; validan, envelope, delegan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B5EA7;strokeColor=#1B3F73;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="b_fastapi">
          <mxGeometry x="40" y="60" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="&lt;b&gt;Gateway WebSocket&lt;/b&gt;&#xa;&lt;i&gt;[M&#243;dulo : FastAPI WS]&lt;/i&gt;&#xa;&#xa;Stream de logs/m&#233;tricas en vivo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B5EA7;strokeColor=#1B3F73;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="b_fastapi">
